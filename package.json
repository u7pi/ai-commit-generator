{
  "name": "simple-ai-committer",
  "displayName": "Simple AI Committer",
  "description": "A simple, practical AI commit message generator. Turn staged Git diffs into commit messages using any OpenAI-compatible LLM.",
  "version": "0.3.1",
  "publisher": "u7pi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "commit message",
    "ai commit",
    "conventional commits",
    "git automation",
    "source control",
    "openai",
    "gemini",
    "ollama",
    "productivity"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/u7pi/ai-commit-generator"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-commit.generateCommitMessage",
        "title": "%command.generate.title%",
        "icon": "$(wand)"
      },
      {
        "command": "ai-commit.selectApiBaseUrl",
        "title": "%command.selectApiBaseUrl.title%"
      },
      {
        "command": "ai-commit.setApiKey",
        "title": "%command.setApiKey.title%"
      },
      {
        "command": "ai-commit.clearApiKey",
        "title": "%command.clearApiKey.title%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "ai-commit.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "aiCommit.apiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%config.apiBaseUrl.description%"
        },
        "aiCommit.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%"
        },
        "aiCommit.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "%config.model.description%"
        },
        "aiCommit.systemPrompt": {
          "type": "string",
          "default": "# Git Commit Message Guide\n\n## Role\nYou are a Git commit message assistant. Output only the commit message, with no explanation, greeting, or extra content.\n\n## Output format\n<type>(<scope>): <subject>\n\n<body>\n\n## Type reference\n| Type     | Emoji | Description         |\n| -------- | ----- | ------------------- |\n| feat     | ✨    | New feature         |\n| fix      | 🐛    | Bug fix             |\n| docs     | 📝    | Documentation       |\n| style    | 💄    | Code formatting     |\n| refactor | ♻️    | Refactoring         |\n| perf     | ⚡️   | Performance         |\n| test     | ✅    | Tests               |\n| build    | 📦    | Build system        |\n| ci       | 👷    | CI configuration    |\n| chore    | 🔧    | Other maintenance   |\n\n## Rules\n1. Use an imperative subject with a lowercase first letter and no trailing period\n2. Use a lowercase English scope, such as auth, api, or ui\n3. Use bullet points in the body to describe reasons and details when needed\n4. Output only the commit message, without markdown code fences\n5. Write the subject and body in English, regardless of the language in the diff",
          "description": "%config.systemPrompt.description%",
          "editPresentation": "multilineText"
        },
        "aiCommit.maxDiffChars": {
          "type": "integer",
          "minimum": 1,
          "default": 6000,
          "description": "%config.maxDiffChars.description%"
        },
        "aiCommit.temperature": {
          "type": "number",
          "default": -1,
          "anyOf": [{ "enum": [-1] }, { "minimum": 0, "maximum": 2 }],
          "description": "%config.temperature.description%"
        },
        "aiCommit.timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 30000,
          "description": "%config.timeoutMs.description%"
        },
        "aiCommit.gitPath": {
          "type": "string",
          "default": "git",
          "description": "%config.gitPath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "node --test scripts/extension.test.cjs",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "simple-git": "^4.0.2"
  }
}
